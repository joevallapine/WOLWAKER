<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Despertar PC (Wake-on-LAN)"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Debes estar conectado a la misma red WiFi que tu PC."
            android:textSize="13sp"
            android:textColor="#666666"
            android:layout_marginBottom="24dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nombre del equipo (opcional)"
            android:textSize="13sp"
            android:layout_marginBottom="4dp" />

        <EditText
            android:id="@+id/editName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Mi PC"
            android:inputType="text"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Dirección MAC del PC"
            android:textSize="13sp"
            android:layout_marginBottom="4dp" />

        <EditText
            android:id="@+id/editMac"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="AA:BB:CC:DD:EE:FF"
            android:inputType="textCapCharacters"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="IP de broadcast de tu red"
            android:textSize="13sp"
            android:layout_marginBottom="4dp" />

        <EditText
            android:id="@+id/editBroadcast"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="255.255.255.255"
            android:inputType="text"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Se autocompleta según tu WiFi actual. Normalmente no hay que tocarlo."
            android:textSize="11sp"
            android:textColor="#888888"
            android:layout_marginBottom="24dp" />

        <Button
            android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Guardar datos"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btnWake"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="⚡ Encender PC"
            android:textSize="18sp"
            android:backgroundTint="@color/purple_700"
            android:textColor="@color/white" />

        <TextView
            android:id="@+id/textStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:textSize="14sp"
            android:text="" />

    </LinearLayout>
</ScrollView>
